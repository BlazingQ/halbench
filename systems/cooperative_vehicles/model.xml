<?xml version='1.0' encoding='utf-8'?>
<sspaceex xmlns="http://www-verimag.imag.fr/xml-namespaces/sspaceex" version="0.2" math="SpaceEx">
  <component id="plant">
    <param name="e1" type="real" local="false" d1="1" d2="1" dynamics="any" controlled="true" />
    <param name="e1prime" type="real" local="false" d1="1" d2="1" dynamics="any" controlled="true" />
    <param name="a1" type="real" local="false" d1="1" d2="1" dynamics="any" controlled="true" />
    <param name="e2" type="real" local="false" d1="1" d2="1" dynamics="any" controlled="true" />
    <param name="e2prime" type="real" local="false" d1="1" d2="1" dynamics="any" controlled="true" />
    <param name="a2" type="real" local="false" d1="1" d2="1" dynamics="any" controlled="true" />
    <param name="e3" type="real" local="false" d1="1" d2="1" dynamics="any" controlled="true" />
    <param name="e3prime" type="real" local="false" d1="1" d2="1" dynamics="any" controlled="true" />
    <param name="a3" type="real" local="false" d1="1" d2="1" dynamics="any" controlled="true" />
    <param name="tau" type="real" local="false" d1="1" d2="1" dynamics="any" controlled="true" />
    <param name="aL" type="real" local="false" d1="1" d2="1" dynamics="any" controlled="false" />
    <location id="1" name="q1">
      <invariant>true</invariant>
      <flow>e1' == e1prime &amp; e1prime' == -a1 + aL &amp; a1' == 1.605*e1 + 4.868*e1prime - 3.5754*a1 - 0.8198*e2 + 0.427*e2prime - 0.045*a2 - 0.1942*e3 + 0.3626*e3prime - 0.0946*a3 &amp; e2' == e2prime &amp; e2prime' == a1 - a2 &amp; a2' == 0.8718*e1 + 3.814*e1prime - 0.0754*a1 + 1.1936*e2 + 3.6258*e2prime - 3.2396*a2 - 0.595*e3 + 0.1294*e3prime - 0.0796*a3 &amp; e3' == e3prime &amp; e3prime' == a2 - a3 &amp; a3' == 0.7132*e1 + 3.573*e1prime - 0.0964*a1 + 0.8472*e2 + 3.2568*e2prime - 0.0876*a2 + 1.2726*e3 + 3.072*e3prime - 3.1356*a3 &amp; tau' == 1</flow>
    </location>
    <location id="3" name="q3">
      <invariant>true</invariant>
      <flow>e1' == e1prime &amp; e1prime' == -a1 + aL  &amp; a1' == 1.605*e1 + 4.868*e1prime - 3.5754*a1 &amp; e2' == e2prime  &amp; e2prime' == a1 - a2  &amp; a2' == 1.1936*e2 + 3.6258*e2prime - 3.2396*a2  &amp; e3' == e3prime  &amp; e3prime' == a2 - a3  &amp; a3' == 0.7132*e1 + 3.573*e1prime - 0.0964*a1 + 0.8472*e2 + 3.2568*e2prime - 0.0876*a2 + 1.2726*e3 + 3.072*e3prime - 3.1356*a3  &amp; tau' == 1</flow>
    </location>
    <transition source="1" target="3" asap="true">
      <guard>tau &gt;= 2</guard>
      <assignment>e1' == e1 &amp; e1prime' == e1prime &amp; a1' == a1 &amp; e2' == e2 &amp; e2prime' == e2prime &amp; a2' == a2 &amp; e3' == e3 &amp; e3prime' == e3prime &amp; a3' == a3 &amp; tau' == 0</assignment>
    </transition>
    <transition source="3" target="1" asap="true">
      <guard>tau &gt;= 2</guard>
      <assignment>e1' == e1 &amp; e1prime' == e1prime &amp; a1' == a1 &amp; e2' == e2 &amp; e2prime' == e2prime &amp; a2' == a2 &amp; e3' == e3 &amp; e3prime' == e3prime &amp; a3' == a3 &amp; tau' == 0</assignment>
    </transition>

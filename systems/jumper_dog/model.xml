<?xml version='1.0' encoding='utf-8'?>
<sspaceex xmlns="http://www-verimag.imag.fr/xml-namespaces/sspaceex" version="0.2" math="SpaceEx">
  <component id="plant">
    <param name="x1" type="real" local="false" d1="1" d2="1" dynamics="any" controlled="true" />
    <param name="x2" type="real" local="false" d1="1" d2="1" dynamics="any" controlled="true" />
    <param name="x3" type="real" local="false" d1="1" d2="1" dynamics="any" controlled="true" />
    <param name="x4" type="real" local="false" d1="1" d2="1" dynamics="any" controlled="true" />
    <location id="1" name="q1">
      <invariant>true</invariant>
      <flow>x1' == x3 &amp; x2' == x4 &amp; x3' == 10 &amp; x4' == 2</flow>
    </location>
    <location id="2" name="q2">
      <invariant>true</invariant>
      <flow>x1' == x3 &amp; x2' == x4 &amp; x3' == 0 &amp; x4' == -10</flow>
    </location>
    <transition source="1" target="2" asap="true">
      <guard>x2 &gt;= 0.5</guard>
      <assignment>x1' == x1 &amp; x2' == x2 &amp; x3' == x3 &amp; x4' == x4</assignment>
    </transition>
    <transition source="2" target="1" asap="true">
      <guard>x2 &lt;= 0.45</guard>
      <assignment>x1' == x1 &amp; x2' == x2 &amp; x3' == x3 &amp; x4' == x4</assignment>
    </transition>
  </component>
</sspaceex>